// src/connected_components.dl
// Connected Components Algorithm using Transitive Closure
// Simpler and faster than LPA - assigns all nodes in same component the same label

// --- Inputs ---
.decl edge(x: symbol, y: symbol)
.input edge(delimiter=",")

// --- Outputs ---
.decl component(n: symbol, c: symbol)
.output component(delimiter=",")

// --- Logic ---

// 1. Create undirected view
.decl link(x: symbol, y: symbol)
link(X, Y) :- edge(X, Y).
link(X, Y) :- edge(Y, X).

// 2. Reachability (transitive closure)
.decl reachable(x: symbol, y: symbol)
reachable(X, Y) :- link(X, Y).
reachable(X, Y) :- link(X, Z), reachable(Z, Y).

// 3. Each node is reachable from itself
reachable(X, X) :- link(X, _).
reachable(X, X) :- link(_, X).

// 4. Component assignment: Find the lexicographically smallest reachable node
// Use a helper to check if there's a smaller reachable node
.decl has_smaller_reachable(n: symbol, candidate: symbol)
has_smaller_reachable(N, Candidate) :-
    reachable(N, Candidate),
    reachable(N, Smaller),
    ord(Smaller) < ord(Candidate).

// 5. Component ID is the reachable node with no smaller reachable node
.decl component_id(n: symbol, c: symbol)
component_id(N, C) :-
    reachable(N, C),
    !has_smaller_reachable(N, C).

// 6. Final component assignment
component(N, C) :- component_id(N, C).
