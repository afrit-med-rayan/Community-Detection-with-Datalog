// -----------------------------------------------------------------------------
// Community Detection: Label Propagation Algorithm (LPA)
// Robust Implementation using Stratified Negation (No unstable aggregators)
// -----------------------------------------------------------------------------

.decl edge(x: symbol, y: symbol)
.input edge
.decl node(x: symbol)
.input node
.decl config_max_iter(i: number)
.input config_max_iter

// 1. Graph Setup (Undirected)
.decl link(x: symbol, y: symbol)
link(X, Y) :- edge(X, Y).
link(X, Y) :- edge(Y, X).

// 2. State: label(Node, Label, Iteration)
.decl label(n: symbol, l: symbol, i: number)

// Init: Each node has its own label at iter 0
label(N, N, 0) :- node(N).

// -----------------------------------------------------------------------------
// Recursive Step Logic
// -----------------------------------------------------------------------------

// A. Count frequency of each label in the neighborhood
.decl label_counts(n: symbol, l: symbol, c: number, i: number)
label_counts(N, L, C, I) :-
    link(N, M),
    label(M, L, I),
    C = count : { link(N, M2), label(M2, L, I) }.

// B. Find the MAXIMUM frequency for each node
.decl max_freq(n: symbol, max_c: number, i: number)
max_freq(N, MaxC, I) :-
    label_counts(N, _, _, I),
    MaxC = max C : { label_counts(N, _, C, I) }.

// C. Candidate Labels: All labels that have the max frequency
.decl candidate_labels(n: symbol, l: symbol, i: number)
candidate_labels(N, L, I) :-
    max_freq(N, MaxC, I),
    label_counts(N, L, MaxC, I).

// D. Tie-Breaking: Pick the "Smallest" candidate (lexicographically)
// We use negation to find the one where NO smaller candidate exists.
.decl smaller_candidate_exists(n: symbol, l: symbol, i: number)
smaller_candidate_exists(N, L, I) :-
    candidate_labels(N, L, I),
    candidate_labels(N, OtherL, I),
    ord(OtherL) < ord(L). // Compare symbol ordinals

.decl next_label(n: symbol, l: symbol, i: number)
next_label(N, L, I) :-
    candidate_labels(N, L, I),
    !smaller_candidate_exists(N, L, I).

// E. Update Rule
label(N, L, I + 1) :-
    next_label(N, L, I),
    config_max_iter(Max),
    I < Max.

// -----------------------------------------------------------------------------
// Output
// -----------------------------------------------------------------------------

// Find last iteration
.decl final_iter(i: number)
final_iter(I) :- I = max It : { label(_, _, It) }.

.decl community(n: symbol, c: symbol)
.output community
community(N, C) :- 
    label(N, C, I), 
    final_iter(I).
