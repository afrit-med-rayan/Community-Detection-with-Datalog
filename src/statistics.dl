// src/statistics.dl
// Calculates structural properties of the graph: Degree Centrality and Triangles.

// --- Inputs ---
.decl edge(x: symbol, y: symbol)
.input edge(delimiter=",")

// --- Outputs ---
.decl node_degree(n: symbol, d: number)
.output node_degree(delimiter=",")

.decl total_triangles(tri_count: number)
.output total_triangles(delimiter=",")

// --- Logic ---

// 1. Undirected Link
.decl link(x: symbol, y: symbol)
link(X, Y) :- edge(X, Y).
link(X, Y) :- edge(Y, X).

// 2. Node Degree
// "Degree Centrality" from requirements
node_degree(N, D) :-
    link(N, _),
    D = count : { link(N, _) }.

// 3. Triangle Counting
// "Clustering-based approaches" - Triangles are the building block
.decl triangle(a: symbol, b: symbol, c: symbol)
triangle(A, B, C) :-
    link(A, B),
    link(B, C),
    link(C, A),
    ord(A) < ord(B), // Symmetry breaking to count each triangle once
    ord(B) < ord(C).

total_triangles(C) :-
    C = count : { triangle(_, _, _) }.
