// -----------------------------------------------------------------------------
// Community Detection: Connected Components (Stratified)
// Separation of Recursion and Aggregation to avoid Cyclic errors.
// -----------------------------------------------------------------------------

.decl edge(x: symbol, y: symbol)
.input edge
.decl node(x: symbol)
.input node
.decl config_max_iter(i: number)
.input config_max_iter

// Basic Graph
.decl link(x: symbol, y: symbol)
link(X, Y) :- edge(X, Y).
link(X, Y) :- edge(Y, X).

// 1. Recursive Reachability (Transitive Closure)
// Note: efficient for small-medium graphs.
.decl reachable(x: symbol, y: symbol)
reachable(X, Y) :- link(X, Y).
reachable(X, Z) :- reachable(X, Y), link(Y, Z).
// Self-reachability
reachable(X, X) :- node(X).

// 2. Community Definition: The minimal Node ID in the reachable set.
// This runs AFTER reachable is fully computed (Stratified).
.decl community_ord(n: symbol, min_ord: number)
community_ord(N, MinOrd) :-
    node(N),
    MinOrd = min ord(L) : { reachable(N, L) }.

.decl community(n: symbol, l: symbol)
.output community
community(N, L) :-
    community_ord(N, MinOrd),
    L = to_string(MinOrd).
